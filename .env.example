# ── Sports Data ───────────────────────────────────────────────────────────────
# Free key at https://the-odds-api.com (500 requests/month)
ODDS_API_KEY=your_odds_api_key_here

# ── AI (Groq — free at groq.com, no credit card needed) ──────────────────────
# 1. Go to console.groq.com → Sign up free → API Keys → Create key
GROQ_API_KEY=your_groq_api_key_here

# ── Auth (Supabase — free at supabase.com) ────────────────────────────────────
# 1. Go to supabase.com → New project
# 2. Settings → API → copy URL and anon key
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# 1. dashboard.stripe.com → Developers → API keys
# 2. Create a $30/month recurring product → copy Price ID
# 3. Webhooks → Add endpoint → copy signing secret
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_PRICE_ID=price_your_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── App ───────────────────────────────────────────────────────────────────────
# Update this to your deployed URL when you go live
APP_URL=http://localhost:8501
